# --- Camera connection ---
STREAM_MODE=rtsp
# rtsp | cloud

# rtsp mode
RTSP_URL=rtsp://admin:yourpassword@192.168.1.50:554/Streaming/Channels/102

# cloud mode (only needed if STREAM_MODE=cloud)
DEVICE_SERIAL=
VERIFICATION_CODE=
HCNETSDK_PATH=

# --- Detection ---
DETECTION_CONFIDENCE=0.8
NOTIFY_COOLDOWN_SECONDS=30

# --- Notifications ---
# Configure at least one of the two blocks below.

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Next.js dashboard (optional) - your deployed Vercel URL
DASHBOARD_URL=https://your-app.vercel.app
DASHBOARD_API_KEY=
